SUNO_SUPABASE_URL=https://cxgynadprukyeuqbchbs.supabase.co
SUNO_EXPECTED_PROJECT_REF=cxgynadprukyeuqbchbs
SUNO_SUPABASE_SERVICE_ROLE_KEY=
# Keep false until the correct Suno Supabase project is verified.
SUNO_ASSIGNMENTS_ENABLED=false
# Makata Studios clients move to Suno Makata (-1004498344479).
SUNO_MAKATA_ENABLED=false
# Trabawho-only handoff threshold. Production uses 26; 100 requires completed briefs.
SUNO_MIN_DETAILS_PERCENT=26
# All teams: 20-minute direct offer, then 10-minute eligible volunteer window.
NEW_CLIENT_VOLUNTEER_ENABLED=false
# Configured Veo teams and Suno/Trabawho: continuous /ready, 15-minute acceptance, TAKE stays available. Assignments require a page mapping.
NEW_CLIENT_READY_ENABLED=false
# First PHT work date using three multi-select hourly polls (24 hours total).
HOURLY_AVAILABILITY_START_DATE=
# Recruiter poll plus 23:59 PHT shares report. First 8 and unlocked bonus 8 never expire.
DONE_DEAL_TRACKING_ENABLED=false
DONE_DEAL_SUMMARY_ENABLED=true
REFERRAL_INCENTIVES_ENABLED=false
REFERRAL_START_DATE=
REFERRAL_COMMISSION_BASIS=gross
REFERRAL_WINDOW_START=join_or_vote
# Map these to the verified Suno schema before enabling client assignments.
SUNO_CLIENTS_TABLE=chatbot_contact_states
SUNO_CLIENT_ID_COLUMN=contact_id
SUNO_CLIENT_NAME_COLUMN=contacts.name
SUNO_CLIENT_DETAILS_COLUMN=collected_details
SUNO_COMPLETION_COLUMN=stop_reason
SUNO_COMPLETION_VALUE=details_collected
# Optional stable customer identity and date columns. Relation paths are supported.
SUNO_CLIENT_IDENTITY_COLUMN=contacts.psid
SUNO_CLIENT_DATE_COLUMN=contacts.last_interaction_at
# Relation-backed Facebook page name shown on each Trabawho assignment.
SUNO_PAGE_NAME_COLUMN=pages.name
ALLOWED_CHAT_IDS=
# Optional outgoing automation subset. Absent = all approved; empty = all paused.
# Archive collection continues for ALLOWED_CHAT_IDS. Trabawho and manager reports:
# Main VEO (Sama only), Suno Trabawho, Suno Makata and DAILY REPORTS.
# AUTOMATION_CHAT_IDS=-1003647732254,-1002894511895,-1004498344479,-1004362432984
# Independent switch: keep VEO polls/reports on while disabling VEO client offers and controls.
VEO_NEW_CLIENTS_ENABLED=false
# Tag known nonvoters in tomorrow's poll six times during the Philippine day.
AVAILABILITY_REMINDERS_ENABLED=false
TELEGRAM_WEBHOOK_SECRET=
INSIGHTS_API_KEY=
# Daily manager-only VEO output/observed-capacity reports after 00:10 PHT.
MEMBER_CAPACITY_REPORTS_ENABLED=false
# Manager reports in the verified per-team DAILY REPORTS topics.
ORGANIZED_REPORTS_ENABLED=false
